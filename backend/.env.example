# Local dev server
ENV=dev
HOST=127.0.0.1
PORT=8000

# Upstream order book WebSocket feed
WS_ENDPOINT=wss://example-feed/ws/l2-orderbook/okx/BTC-USDT-SWAP

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Gemini API key and model
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated allowed origins (Vercel previews are allowed via CORS_ORIGIN_REGEX)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Admin service account JSON (defaults to app/firebase-adminsdk.json,
# or /etc/secrets/firebase-adminsdk.json when IS_RENDER=true)
# FIREBASE_CREDENTIALS_PATH=
